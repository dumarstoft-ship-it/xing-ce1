  "corrected_simplifications": [
   {
    "risk": "用‘心、我、道、理’等单字直接判定哲学立场。",
    "correction": "按完整命题判断何者第一性；有歧义的名句不制成无条件单选。"
   },
   {
    "risk": "把哲学物质定义为具体物品的简单总和。",
    "correction": "强调对客观实在性共同特征的概括，区分物质范畴与具体形态。"
   },
   {
    "risk": "由肯定因素引出‘任何存在都在价值上合理’。",
    "correction": "肯定因素描述维持现有性质，不是价值正当性的通行证。"
   },
   {
    "risk": "把任何三阶段经历都认定为否定之否定的严格证明。",
    "correction": "例子只帮助理解；须分析内部否定、保留和发展关系。"
   },
   {
    "risk": "把偶然来源写成‘非根本矛盾的外部条件’并据此机械推断。",
    "correction": "通常区分根本矛盾与非根本矛盾、外部条件；不简化成所有内因必然、所有外因偶然。"
   },
   {
    "risk": "把量变到质变的关系删去程度、度及条件。",
    "correction": "任何微小量变不自动已经构成质变。"
   },
   {
    "risk": "把形成理性认识直接当成形成正确认识。",
    "correction": "感性理性是层次，正确错误是是否符合对象；科学加工是获得正确理性认识的条件。"
   },
   {
    "risk": "仅以维护现有经济基础就认定上层建筑促进进步。",
    "correction": "进一步检查它所服务的经济基础是否适合生产力发展。"
   },
   {
    "risk": "把法律主要规范行为改成法律完全没有思想教育作用。",
    "correction": "区分主要作用方式与全部作用，同时不推出可以任意惩罚单纯思想。"
   }
  ]
 },
